import logging
import os
import json
import pyodbc
from datetime import datetime
import azure.functions as func

# GET: Payment Status
def main_get(req: func.HttpRequest) -> func.HttpResponse:
    logging.info('Processing GET payment status request.')

    studentid = req.route_params.get('studentid', None)
    if not studentid or not studentid.isdigit():
        return func.HttpResponse(
            "Please provide a valid integer studentId.",
            status_code=400
        )

    id = int(studentid)
    connection_string = os.getenv('SqlConnectionString')
    status = "Not Found"
    total_fee = 0
    paid_amount = 0
    due_date = None

    try:
        with pyodbc.connect(connection_string) as conn:
            cursor = conn.cursor()
            cursor.execute("SELECT TotalFee, PaidAmount, DueDate FROM Students WHERE StudentID = ?", id)
            row = cursor.fetchone()
            if row:
                total_fee = row.TotalFee if row.TotalFee is not None else 0
                paid_amount = row.PaidAmount if row.PaidAmount is not None else 0
                due_date = row.DueDate.isoformat() if row.DueDate is not None else None

                if paid_amount >= total_fee:
                    status = "Paid"
                elif paid_amount > 0:
                    status = "Partially Paid"
                elif due_date and datetime.fromisoformat(due_date) < datetime.utcnow():
                    status = "Overdue"
                else:
                    status = "Pending"
    except Exception as ex:
        logging.error(f"Error fetching student fee status: {ex}")
        return func.HttpResponse(
            "Error fetching student fee status.",
            status_code=500
        )

    if status == "Not Found":
        return func.HttpResponse(
            "",
            status_code=404
        )

    result = {
        "studentId": id,
        "totalFee": total_fee,
        "paidAmount": paid_amount,
        "dueDate": due_date,
        "status": status
    }
    return func.HttpResponse(
        json.dumps(result),
        mimetype="application/json",
        status_code=200
    )


# PUT: Update Fee Record
def main_put(req: func.HttpRequest) -> func.HttpResponse:
    logging.info('Processing PUT update fee record request.')

    studentid = req.route_params.get('studentid', None)
    if not studentid or not studentid.isdigit():
        return func.HttpResponse(
            "Please provide a valid integer studentId.",
            status_code=400
        )

    id = int(studentid)
    try:
        update_data = req.get_json()
    except ValueError:
        return func.HttpResponse(
            "Invalid JSON format.",
            status_code=400
        )

    paid_amount = update_data.get('paidAmount')
    if paid_amount is None:
        return func.HttpResponse(
            "Please provide 'paidAmount' in the request body.",
            status_code=400
        )

    connection_string = os.getenv('SqlConnectionString')
    try:
        with pyodbc.connect(connection_string) as conn:
            cursor = conn.cursor()
            cursor.execute("SELECT COUNT(*) FROM Students WHERE StudentID = ?", id)
            result = cursor.fetchone()
            exists = result if result else 0
            if exists == 0:
                return func.HttpResponse(
                    f"Student with ID {id} not found.",
                    status_code=404
                )

            # Perform update
            cursor.execute("UPDATE Students SET PaidAmount = ? WHERE StudentID = ?", paid_amount, id)
            conn.commit()
    except Exception as ex:
        logging.error(f"Error updating student fee record: {ex}")
        return func.HttpResponse(
            "Error updating student fee record.",
            status_code=500
        )

    return func.HttpResponse(
        json.dumps({"message": f"Successfully updated fee record for studentId {id}."}),
        mimetype="application/json",
        status_code=200
    )
